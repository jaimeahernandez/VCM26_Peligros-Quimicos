        <p
          style="color: #ffc107; font-size: 14px; margin-top: 10px; font-style: italic; letter-spacing: 1px;">
          Guía de Instrumentación para Higiene Ocupacional</p>
      </div>
      <div class="p-4"
        style="background-image: radial-gradient(#d1d5db 0.6px, transparent 0.6px); background-size: 15px 15px;">
        <!-- Navegación de Pestañas -->
        <ul
          class="nav nav-pills flex-row text-center mb-4 justify-content-center"
          style="background: rgba(255,255,255,0.8); border-radius: 50px; padding: 10px; border: 1px solid #e2e8f0;"
          role="tablist">
          <li class="nav-item"><a class="nav-link active show"
